<resources>
    <!-- Базовая тема приложения. UI рисуется Compose (Material3), системная тема — без ActionBar. -->
    <style name="Theme.FuelMap" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Экран-заставка (core-splashscreen). -->
    <style name="Theme.FuelMap.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FuelMap</item>
    </style>
</resources>
