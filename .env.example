# --- Telegram ---
# Токен от @BotFather (/mybots → API Token). Вставь сюда свой —
# в git не коммитить, файл копируется в backend/.env (он в .gitignore).
BOT_TOKEN=
WEBHOOK_SECRET=dev-webhook-secret            # смени на случайную строку в проде
PUBLIC_URL=                                  # публичный HTTPS-домен (для setWebhook и кнопки в /start)

# --- App ---
PORT=8080
HOST=0.0.0.0
JWT_SECRET=dev-jwt-secret-change-in-prod     # смени на длинную случайную строку в проде
SESSION_TTL=86400                            # срок жизни JWT, сек
INIT_DATA_MAX_AGE=3600                       # auth_date не старше 1 ч

# --- Storage ---
DATABASE_URL=postgres://mybot:mybot@localhost:5432/mybot
REDIS_URL=redis://localhost:6379

# --- Catalog cache ---
CATALOG_TTL=600                              # Redis TTL каталога подарков, сек (5–15 мин)

# --- Admin ---
ADMIN_IDS=8486449177                         # админы мини-аппа через запятую

# --- Dev ---
# Для локальной разработки без реального Telegram раскомментируй и запусти
# `node dev/telegram-emulator.js` в backend/:
# TELEGRAM_API_BASE=http://localhost:8081
