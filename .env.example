# --- Telegram ---
# Токен от @BotFather (/mybots -> API Token). В git не коммитить.
BOT_TOKEN=

# secret_token для вебхука; в проде смени на случайную строку
WEBHOOK_SECRET=dev-webhook-secret

# Публичный HTTPS-домен. Пусто = npm run go поднимет туннель сам.
PUBLIC_URL=

# --- App ---
PORT=8080
# Подпись JWT; в проде смени на длинную случайную строку
JWT_SECRET=dev-jwt-secret-change-in-prod
# Срок жизни JWT (сек) и максимальный возраст initData (1 ч)
SESSION_TTL=86400
INIT_DATA_MAX_AGE=3600

# --- Storage ---
# По умолчанию SQLite-файл, ничего ставить не надо (Docker не нужен).
# Для продакшена на несколько процессов раскомментируй Postgres/Redis:
# DATABASE_URL=postgres://mybot:mybot@localhost:5432/mybot
# REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite:data/app.db

# Кэш каталога подарков (сек, 5-15 мин)
CATALOG_TTL=600

# --- Admin ---
# Админы мини-аппа через запятую
ADMIN_IDS=8486449177

# --- Dev ---
# Локальный эмулятор Bot API (node dev/telegram-emulator.js):
# TELEGRAM_API_BASE=http://localhost:8081
