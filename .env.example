# --- Telegram ---
BOT_TOKEN=123456789:AA...            # токен бота от @BotFather
WEBHOOK_SECRET=change-me-random-32   # secret_token для setWebhook (X-Telegram-Bot-Api-Secret-Token)
PUBLIC_URL=https://example.com       # публичный HTTPS-домен backend'а (для setWebhook)

# --- App ---
PORT=8080
HOST=0.0.0.0
JWT_SECRET=change-me-long-random     # подпись собственных JWT-сессий
SESSION_TTL=86400                    # срок жизни JWT, сек
INIT_DATA_MAX_AGE=3600               # auth_date не старше 1 ч

# --- Storage ---
DATABASE_URL=postgres://mybot:mybot@localhost:5432/mybot
REDIS_URL=redis://localhost:6379

# --- Catalog cache ---
CATALOG_TTL=600                      # Redis TTL каталога подарков, сек (5–15 мин)
